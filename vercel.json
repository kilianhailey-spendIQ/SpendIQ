{
  "rewrites": [
    {
      "source": "/ocr.js",
      "destination": "/ocr.js"
    },
    {
      "source": "/(.*)",
      "destination": "https://gi4i1z5e61x8msy1v46w.share.dreamflow.app/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}